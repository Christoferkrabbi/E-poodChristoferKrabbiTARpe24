@model string

@{
    ViewData["Title"] = "Result";
}

<h2>Thank you!</h2>

@if (!string.IsNullOrEmpty(Model))
{
    <div class="alert alert-success">
        <strong>Booking confirmed:</strong>
        <div>@Model</div>
    </div>
}
else
{
    <div class="alert alert-info">
        Your booking was received. You will receive confirmation shortly.
    </div>
}

<p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Home</a>
    <a asp-action="Create" asp-controller="Booking" class="btn btn-secondary">Make another booking</a>
</p>