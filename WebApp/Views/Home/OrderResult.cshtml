@model OrderResultViewModel

@{
    var result = Model?.Result ?? "No result";
    var isSuccess = Model?.IsSuccess ?? false;
}

<h2>Order Result</h2>

@if (isSuccess)
{
    <div style="color: green; font-weight: bold;">
        ✅ @result
    </div>
}
else
{
    <div style="color: red; font-weight: bold;">
        ❌ @result
    </div>
}

<br />
<a href="/Store/Index">Back to store</a>