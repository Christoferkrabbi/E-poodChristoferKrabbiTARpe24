    </thead>
<tbody>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.Price</td>
            <td>
                <form method="post" action="/Home/CreateOrder">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <button type="submit" class="btn btn-primary">Buy</button>
                </form>
            </td>
        </tr>
    }
</tbody>
</table>