@model IEnumerable<WebApp.Models.CartItem>
@{
    decimal total = 0;
}

<div class="container" style="margin-top: 20px; font-family: sans-serif;">
    <h2>Your Cart</h2>

    <div class="row">
        <!-- Products Summary Column -->
        <div class="col-md-8">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var itemTotal = item.Price * item.Quantity;
                        total += itemTotal;

                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Price €</td>
                            <td>@item.Quantity</td>
                            <td>@itemTotal €</td>
                            <td>
                                <form method="post" asp-action="RemoveFromCart">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button class="btn btn-danger btn-sm">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Shipping Logistics Details Form Section -->
            <div class="card card-body bg-light mt-4" style="padding: 20px; border-radius: 8px;">
                <h4 class="mb-3">Kohaletoimetamise andmed</h4>
                
                <form method="post" asp-action="Checkout">
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-3">
                        <label class="control-label" style="font-weight: 600;">Täielik Aadress *</label>
                        <input type="text" name="address" required class="form-control" placeholder="Tänav, maja, korter" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="control-label" style="font-weight: 600;">Linn *</label>
                            <input type="text" name="city" required class="form-control" placeholder="nt. Tallinn" />
                        </div>
                        <div class="col-md-6 form-group mb-4">
                            <label class="control-label" style="font-weight: 600;">Postiindeks *</label>
                            <input type="text" name="postalCode" required class="form-control" placeholder="nt. 10135" />
                        </div>
                    </div>

                    <div class="form-group mb-0">
                        <button type="submit" class="btn btn-success w-100 btn-lg" style="font-weight: bold;">
                            Vormista ost ja Maksa (@total €)
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sticky Totals Sidebar Element -->
        <div class="col-md-4">
            <div class="card border-secondary">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Kokkuvõte</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Ostukorv:</span>
                        <strong>@total €</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Transport:</span>
                        <span class="text-success font-weight-bold">Tasuta</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span style="font-size: 1.2rem; font-weight: bold;">KOKKU:</span>
                        <span class="text-primary" style="font-size: 1.4rem; font-weight: bold;">@total €</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
