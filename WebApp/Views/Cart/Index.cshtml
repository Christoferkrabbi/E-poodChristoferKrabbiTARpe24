@{
    decimal total = 0;
}

<div>
    <h2>Your Cart</h2>

    <table>
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Qty</th>
            <th></th>
        </tr>

        @foreach (var item in Model)
{
    var itemTotal = item.Price * item.Quantity;
    total += itemTotal;

    <tr>
        <td>@item.Name</td>
        <td>@item.Price €</td>
        <td>@item.Quantity</td>
        <td>@itemTotal €</td>
        <td>
                    <form method="post" asp-action="RemoveFromCart">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button class="btn-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </table>
    <h2>Total: @total €</h2>

    <form method="post" asp-action="Checkout">
        <button class="btn-success">Checkout</button>
    </form>
</div>