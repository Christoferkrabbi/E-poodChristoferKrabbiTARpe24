<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar">
        <ul class="nav-list">
            <li><a href="/Home/OrderHistory">Order History</a></li>
            <li><a href="/Store/Index">Store</a></li>
            <li><a href="/Cart/Index">Cart</a></li>

            <li class="auth-group">
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-user">Hello, @User.Identity.Name</span>
                    <a  href="/Account/Logout">Logout</a>
                }
                else
                {
                    <a href="/Account/Login">Login</a>
                    <a href="/Account/Register">Register</a>
                }
            </li>
        </ul>
    </nav>

    <div class="background">
        <div class="container">
            @RenderBody()
        </div>
    </div>

    <footer>
        <p>
            &copy; 2026 - WebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
