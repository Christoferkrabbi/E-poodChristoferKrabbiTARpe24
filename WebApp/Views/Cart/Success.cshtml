@model WebApp.Models.OrderResultViewModel
@{
    ViewData["Title"] = "Payment Status";
}

<div class="container text-center" style="margin-top: 80px; max-width: 600px; font-family: sans-serif;">
    <div class="card shadow-sm @(Model?.IsSuccess == true ? "border-success" : "border-danger")">
        <div class="card-body p-5">
            
            @if (Model?.IsSuccess == true)
            {
                <div style="font-size: 70px; color: #28a745;" class="mb-3">✓</div>
                <h2 class="text-dark mb-2">Tellimus on vormistatud!</h2>
            }
            else
            {
                <div style="font-size: 70px; color: #dc3545;" class="mb-3">✕</div>
                <h2 class="text-dark mb-2">Makse ebaõnnestus</h2>
            }

            <p class="text-muted">@Model?.Result</p>
            
            <div class="bg-light text-left p-3 my-4 rounded border" style="text-align: left;">
                <p class="mb-1"><strong>Kasutaja:</strong> @User.Identity?.Name</p>
                <p class="mb-1"><strong>Tellimuse ID:</strong> #@ViewBag.OrderId</p>
                <p class="mb-0"><strong>Kogu summa:</strong> @(ViewBag.TotalAmount ?? "0.00") €</p>
            </div>

            <a asp-action="Index" asp-controller="Store" class="btn btn-primary btn-lg px-4" style="font-weight: bold;">
                Jätka ostlemist
            </a>
        </div>
    </div>
</div>
