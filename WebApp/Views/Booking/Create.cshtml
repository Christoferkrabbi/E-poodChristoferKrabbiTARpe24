@model IEnumerable<WebApp.Entities.PlayTable>

@{
    ViewData["Title"] = "Create Booking";
}

<h2>Create Booking</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-controller="Booking" asp-action="BookTable" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="tableId">Table</label>

        @if (Model != null && Model.Any())
        {
            <select id="tableId" name="tableId" class="form-control">
                @foreach (var t in Model)
                {
                    <option value="@t.Id">@t.TableName</option>
                }
            </select>
        }
    </div>

    <div class="form-group">
        <label for="fromTime">From</label>
        <input id="fromTime" name="fromTime" type="datetime-local" class="form-control" />
    </div>

    <div class="form-group">
        <label for="toTime">To</label>
        <input id="toTime" name="toTime" type="datetime-local" class="form-control" />
    </div>

    <button type="submit" class="button">Book</button>

    <!-- Button that opens TableInfo view for the currently selected table -->
    <button type="button" id="btnTableInfo" class="button" style="margin-left:8px;">
        Table info
    </button>
</form>

@section Scripts {
    <script>
        (function () {
            var btn = document.getElementById('btnTableInfo');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var sel = document.getElementById('tableId');
                if (!sel) {
                    // go to TableInfo list view
                    window.location.href = '@Url.Action("TableInfo", "Table")';
                    return;
                }
                var selected = sel.value;
                // open TableInfo for selected table (query string param "tableId")
                window.location.href = '@Url.Action("TableInfo", "Table")' + '?tableId=' + encodeURIComponent(selected);
            });
        })();
    </script>
}