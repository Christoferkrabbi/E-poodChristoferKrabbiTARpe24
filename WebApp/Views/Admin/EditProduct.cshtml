@model WebApp.Models.Product

<h2>Edit product</h2>

<form asp-action="EditProduct" asp-controller="Admin" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />
    <div>
        <label>Name</label>
        <input name="Name" value="@Model.Name" />
    </div>
    <div>
        <label>Price</label>
        <input name="Price" value="@Model.Price" />
    </div>
    <button type="submit" class="btn">Save</button>
    <a asp-action="Index" asp-controller="Admin" class="btn">Cancel</a>
</form>