@model WebApp.Entities.UserAccount
@{
    ViewData["Title"] = "Minu Konto";
    var ordersList = ViewBag.Orders as IEnumerable<WebApp.Models.Order>;
}

<!-- Uses your pre-defined .container class configuration automatically -->
<div class="container">
    
    <!-- Profile Heading and Trigger Row -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <h2>@Model?.FirstName @Model?.LastName</h2>
            <span class="success">🛡️ @(Model?.Role ?? "User")</span>
        </div>

        <!-- Leverages your native .button stylesheet properties directly -->
        <button type="button" class="button" data-toggle="modal" data-target="#orderHistoryModal" data-bs-toggle="modal" data-bs-target="#orderHistoryModal">
            📜 Tellimuste ajalugu
        </button>
    </div>

    <h4>Konto detailid</h4>
    
    <!-- Clean responsive layout columns utilizing your global input variables -->
    <div class="row">
        <div class="col-md-6 form-group mb-3">
            <label>Kasutajatunnus</label>
            <input type="text" value="@Model?.UserName" readonly class="form-control" />
        </div>
        <div class="col-md-6 form-group mb-3">
            <label>E-maili aadress</label>
            <input type="text" value="@Model?.Email" readonly class="form-control" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 form-group mb-3">
            <label>Süsteemi Roll (Role)</label>
            <input type="text" value="@Model?.Role" readonly class="form-control" />
        </div>
        <div class="col-md-6 form-group mb-3">
            <label>Konto Loomise Kuupäev</label>
            <input type="text" value="📅 June @((Model?.Id % 28) + 1), 2026" readonly class="form-control" />
        </div>
    </div>

</div>

<!-- ================= POPUP MODAL DIALOG INTERFACE ================= -->
<div class="modal fade" id="orderHistoryModal" tabindex="-1" role="dialog" aria-labelledby="orderHistoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        
        <!-- Extends your .container properties so the popup looks identical to your page boxes -->
        <div class="modal-content container">
            
            <div class="modal-header">
                <h5 class="modal-title" id="orderHistoryModalLabel" style="color: #c9a34e; margin: 0;">Order History</h5>
                <button type="button" class="close bg-transparent border-0" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close" style="color: #c9a34e; font-size: 28px;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            
            <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                @if (ordersList == null || !ordersList.Any())
                {
                    <p class="error">No orders found for your account.</p>
                }
                else
                {
                    foreach (var order in ordersList)
                    {
                        <div class="mb-4">
                            <h5>Ordered: @order.CreatedAt.ToString("g")</h5>

                            @if (order.Items != null && order.Items.Any())
                            {
                                <!-- Adopts your global table, th, and td gold accent colors naturally -->
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Item</th>
                                            <th>Qty</th>
                                            <th>Price</th>
                                            <th>Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in order.Items)
                                        {
                                            <tr>
                                                <td>@item.Name</td>
                                                <td>@item.Quantity</td>
                                                <td>@item.Price.ToString("C")</td>
                                                <td>@((item.Price * item.Quantity).ToString("C"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            <p><strong>Total:</strong> <span class="success">@order.Total.ToString("C")</span></p>
                        </div>
                    }
                }
            </div>
            
            <div class="modal-footer">
                <button type="button" class="button" data-dismiss="modal" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://jquery.com"></script>
    <script src="https://jsdelivr.net"></script>
}
